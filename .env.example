# Copy these into Netlify: Site configuration > Environment variables.
# NEVER put the secret values (marked SECRET) in the public website or in git.

# --- Database (Supabase) ---------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx        # public "anon/publishable" key (safe in browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=                              # SECRET  (service_role / sb_secret_ key)

# --- Scheduled jobs ------------------------------------------------------------
CRON_SECRET=                                            # SECRET  long random string, e.g. `openssl rand -hex 32`

# --- Public website ------------------------------------------------------------
PUBLIC_SITE_URL=https://teachershaspeaking.netlify.app
PUBLIC_BOOKING_URL=https://teachershaspeaking.netlify.app/#daftar   # link in the renewal reminder
ALLOWED_ORIGINS=https://teachershaspeaking.netlify.app             # comma-separated

# --- BCL -----------------------------------------------------------------------
BCL_API_TOKEN=                                          # SECRET
BCL_PORTAL_KEY=                                         # SECRET  (needed for per-booking payment links)
BCL_TEST_MODE=true                                      # set to false only when going live
BCL_PAYMENT_MODE=link                                   # "link" (per-booking BCL link) or "form" (always use the BCL form)
BCL_FORM_URL=https://teachersha.bcl.my/form/spekaing-club
BCL_WEBHOOK_KEY=                                        # optional SECRET; if set, webhook URL must end with ?key=THIS

# --- Google Calendar + Meet + Gmail (Teacher Sha's Google account) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                                   # SECRET
GOOGLE_REFRESH_TOKEN=                                   # SECRET
GOOGLE_CALENDAR_ID=primary
EMAIL_FROM=Teacher Sha Speaking Club <teachersha557@gmail.com>

# --- WhatsApp (Meta Cloud API) -------------------------------------------------
WHATSAPP_ACCESS_TOKEN=                                  # SECRET  (System User permanent token)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                                    # SECRET  (verifies Meta webhooks)
WHATSAPP_VERIFY_TOKEN=                                  # any random string you also type into Meta
WHATSAPP_TEMPLATE_CLASS=class_reminder
WHATSAPP_TEMPLATE_RENEWAL=renewal_reminder
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_LIVE=false                                     # true ONLY after templates are approved and tested
